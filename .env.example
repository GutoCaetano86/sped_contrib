# Copie para .env.local e preencha. Ver docs/DEPLOY.md para o passo a passo
# completo, inclusive quais destas variaveis vao para a Vercel.

# ---------------------------------------------------------------- Supabase
# Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service role: IGNORA a RLS. So no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada apenas pelo job de retencao (/api/cron/retencao).
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------- cron
# Segredo do job diario de retencao. A Vercel manda no header Authorization.
# Gere com: openssl rand -hex 32
# Sem esta variavel a rota fica FECHADA (401), e nao aberta.
CRON_SECRET=

# ------------------------------------------------------------------ Sentry
# Opcional: sem DSN o Sentry fica inerte e a aplicacao roda igual.
NEXT_PUBLIC_SENTRY_DSN=

# So no build da Vercel, para subir source map. Nao precisa em .env.local.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
